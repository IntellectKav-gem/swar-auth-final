# ==========================================
# SWAR-AUTH Project - Master .gitignore
# ==========================================

# Dependencies & Package Managers
node_modules/
**/node_modules/

# Environment Files & Secrets
.env
.env.*
!.env.example
!.env*.example
credentials.json
service-account.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.asc

# Build & Output Directories
dist/
**/dist/
build/
**/build/
out/
.next/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
**/venv/
**/.venv/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Audio Uploads & Temporary Media Files
uploads/
**/uploads/
**/database/*.json
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac

# Log Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Code Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
